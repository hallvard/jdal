<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.jdal</groupId>
  <artifactId>jdal-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>jdal</name>
  <description>Pure Java port of GDAL's vector (OGR) side</description>

  <modules>
    <module>jdal-testkit</module>
    <module>jdal-json</module>
    <module>jdal-config</module>
    <module>jdal-http</module>
    <module>jdal-vsi</module>
    <module>jdal-vsi-curl</module>
    <module>jdal-geom</module>
    <module>jdal-feature</module>
    <module>jdal-srs</module>
    <module>jdal-core</module>
    <module>jdal-ops</module>
    <module>jdal-driver-geojson</module>
    <module>jdal-driver-oapif</module>
    <module>jdal-gml</module>
    <module>jdal-driver-wfs</module>
    <module>jdal-sql</module>
    <module>jdal-filter</module>
    <module>jdal-driver-csv</module>
    <module>jdal-driver-shapefile</module>
    <module>jdal-driver-gpkg</module>
    <module>jdal-driver-postgis</module>
    <module>jdal-utils</module>
    <module>jdal-cli</module>
  </modules>

  <properties>
    <maven.compiler.release>26</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <gdal.autotest>${user.home}/git/gdal/autotest</gdal.autotest>
    <junit.version>6.1.3</junit.version>
    <jts.version>1.20.0</jts.version>
    <proj4j.version>1.4.3</proj4j.version>
    <sqlite.version>3.53.4.0</sqlite.version>
    <postgresql.version>42.7.14</postgresql.version>
    <aesh.version>3.18.2</aesh.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-testkit</artifactId><version>${project.version}</version><scope>test</scope></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-json</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-config</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-http</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-vsi</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-vsi-curl</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-geom</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-feature</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-srs</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-driver-geojson</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-driver-oapif</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-gml</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-driver-wfs</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-driver-csv</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-driver-shapefile</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-driver-gpkg</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-driver-postgis</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-sql</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-filter</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-ops</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.jdal</groupId><artifactId>jdal-utils</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.locationtech.jts</groupId><artifactId>jts-core</artifactId><version>${jts.version}</version></dependency>
      <dependency><groupId>org.locationtech.proj4j</groupId><artifactId>proj4j</artifactId><version>${proj4j.version}</version></dependency>
      <dependency><groupId>org.locationtech.proj4j</groupId><artifactId>proj4j-epsg</artifactId><version>${proj4j.version}</version></dependency>
      <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>${sqlite.version}</version></dependency>
      <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><version>${postgresql.version}</version></dependency>
      <dependency><groupId>org.aesh</groupId><artifactId>aesh</artifactId><version>${aesh.version}</version></dependency>
      <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
    </dependencies>
  </dependencyManagement>

  <!-- every module gets JUnit -->
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version></plugin>
        <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version>
          <configuration><argLine>--enable-native-access=ALL-UNNAMED</argLine><systemPropertyVariables><gdal.autotest>${gdal.autotest}</gdal.autotest></systemPropertyVariables></configuration></plugin>
        <plugin><artifactId>maven-enforcer-plugin</artifactId><version>3.6.3</version></plugin>
      <plugin>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>10.26.1</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>google_checks.xml</configLocation>
          <sourceDirectories>${project.build.sourceDirectory}</sourceDirectories>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <consoleOutput>true</consoleOutput>
          <failsOnError>true</failsOnError>
          <violationSeverity>error</violationSeverity>
        </configuration>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration><compilerArgs><arg>-Xlint:all</arg><arg>-parameters</arg></compilerArgs></configuration>
      </plugin>
      <!-- CONSTRAINTS.md: no native GDAL, only approved libraries -->
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>constraints</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.gdal:*</exclude>
                    <exclude>org.geotools:*</exclude>
                    <exclude>org.locationtech.jts:jts-core:(,1.20.0)</exclude>
                  </excludes>
                  <message>jdal must not depend on GDAL bindings or GeoTools (see CONSTRAINTS.md)</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin><artifactId>maven-checkstyle-plugin</artifactId></plugin>
    </plugins>
  </build>
</project>
